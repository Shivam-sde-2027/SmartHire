# Gemini
GEMINI_API_KEY=

# Supabase
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=

# Database (Supabase Postgres connection string)
DATABASE_URL=postgresql://user:pass@host:5432/postgres

# App
CORS_ORIGINS=http://localhost:5173
UPLOAD_MAX_MB=10

# FAISS index paths (relative to project root)
JOB_FAISS_INDEX_PATH=../data/indexes/job_faiss.index
JOB_METADATA_PATH=../data/indexes/job_metadata.pkl
CAREER_NOTES_FAISS_INDEX_PATH=../data/indexes/career_notes_faiss.index

# Models
GEMINI_LLM_MODEL=gemini-2.5-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
